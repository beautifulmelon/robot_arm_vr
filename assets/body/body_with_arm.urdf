  <link name="arm_mount" />
  <joint name="arm_mount_joint" type="fixed">
    <!-- 팔 base_link(=joint1 원점)이 놓이는 자리 -->
    <parent link="body_base" />
    <child link="arm_mount" />
    <origin xyz="0.314375 -0.000015 0.18446" rpy="0 0 0" />
  </joint>
  <link name="body_camera_mount" />
  <joint name="body_camera_mount_joint" type="fixed">
    <!-- 후상방 카메라(Logitech C920). Fusion 조인트오리진 cam2 에서 가져옴. ROS optical 규약: +Z=광축(보는 방향) +Y=영상아래 +X=영상오른쪽 -->
    <parent link="body_base" />
    <child link="body_camera_mount" />
    <origin xyz="-0.032744 -0.000015 0.77441" rpy="-1.570796327 0 -1.570796327" />
  </joint>
  <!-- ===== 팔 + 손 (기존 검증본 그대로) ===== -->
  <joint name="arm_attach_joint" type="fixed">
    <parent link="arm_mount" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>
