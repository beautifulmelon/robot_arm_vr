  <!-- ============ 카메라 마운트 (Intel RealSense D435i) ============ -->
  <!-- Fusion camera_mount Joint Origin (isFlipped=True) -->
  <!--   광축 Z = -Y(월드) : 팔 바깥쪽 수평. link5/Body6 면#87 법선과 일치 -->
  <!--   영상 위쪽 = +Z(월드). 롤 180도 모호성은 Isaac 에서 육안 확인.     -->
  <link name="camera_mount"/>
  <joint name="camera_mount_joint" type="fixed">
    <parent link="link5"/>
    <child  link="camera_mount"/>
    <origin xyz="-0.002211756 -0.071690174 0.169716543" rpy="-1.570796327 0 -3.141592654"/>
  </joint>

